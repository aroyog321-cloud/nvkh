{
  "manifestVersion": 1,
  "id": "dev.mission-control.test-runner",
  "name": "Test Runner Intelligence",
  "version": "1.0.0",
  "publisher": "Mission Control examples",
  "description": "Reviews bounded test-worker health and may request an approved restart.",
  "permissions": ["health.read", "events.read", "worker.lifecycle.request"],
  "surfaces": ["settings.summary", "health.status", "needs.request"],
  "actions": [{ "id": "restart-tests", "label": "Restart test worker", "type": "worker", "operations": ["restart"] }]
}
