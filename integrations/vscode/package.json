{
  "name": "bridge",
  "displayName": "Mission Control Bridge",
  "description": "Authenticated editor synchronization and explicitly owned managed-terminal control for Mission Control Groundstation.",
  "version": "0.2.0",
  "publisher": "mission-control",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./extension.cjs",
  "activationEvents": [
    "onUri",
    "onCommand:missionControlBridge.connect",
    "onCommand:missionControlBridge.disconnect"
  ],
  "contributes": {
    "commands": [
      {
        "command": "missionControlBridge.connect",
        "title": "Mission Control: Connect Current Project"
      },
      {
        "command": "missionControlBridge.disconnect",
        "title": "Mission Control: Disconnect Bridge"
      }
    ]
  }
}
